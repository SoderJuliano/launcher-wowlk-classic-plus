{
  "name": "olk-plus-launcher",
  "productName": "OLK Plus Launcher",
  "version": "0.1.23",
  "description": "Official launcher for WoW Classic Plus LK (OLK Plus)",
  "author": "Juliano Soder",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:ui": "vite build",
    "start": "npm run build:ui && electron .",
    "test": "node --test \"tests/*.test.cjs\"",
    "dist:win": "npm run build:ui && electron-builder --win",
    "dist:linux": "npm run build:ui && electron-builder --linux",
    "dist:mac": "npm run build:ui && electron-builder --mac"
  },
  "dependencies": {
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/cinzel-decorative": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.5",
    "vue": "^3.5.44",
    "yazl": "^3.3.1"
  },
  "homepage": "https://github.com/SoderJuliano/wowlk-classic-plus-site",
  "build": {
    "appId": "lk.classicplus.launcher",
    "productName": "OLK Plus Launcher",
    "executableName": "olk-plus-launcher",
    "copyright": "© 2026 WoW Classic Plus LK",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "config/**",
      "dist/**",
      "package.json",
      "!**/*.map"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "OLK Plus",
      "artifactName": "OLK-Plus-Launcher-Setup-${version}.exe"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "icon": "build/icon.png",
      "maintainer": "Juliano Soder <julianosoder.js@gmail.com>",
      "synopsis": "Launcher for WoW Classic Plus LK",
      "desktop": {
        "entry": {
          "Name": "OLK Plus Launcher",
          "Comment": "WoW Classic Plus LK launcher",
          "Categories": "Game;"
        }
      }
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnss3",
        "libxss1",
        "libasound2 | libasound2t64",
        "libsecret-1-0"
      ],
      "recommends": [
        "wine"
      ]
    },
    "pacman": {
      "depends": [
        "gtk3",
        "nss",
        "alsa-lib",
        "libsecret"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.games",
      "icon": "build/icon.png"
    },
    "appImage": {
      "artifactName": "OLK-Plus-Launcher-${version}.AppImage"
    }
  }
}
